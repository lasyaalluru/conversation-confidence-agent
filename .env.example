# Copy to .env.local and fill in:   cp .env.example .env.local
# NEVER commit .env.local. Never prefix a secret with NEXT_PUBLIC_ (that sends it to the browser).

# ── AI (server-only) ─────────────────────────────────────────────
# Leave empty to run in clearly-labeled Demo Mode (scripted barista, rule-based feedback, typing only).
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
# OPENAI_CONVERSATION_MODEL=gpt-5.4-mini
# OPENAI_FEEDBACK_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# ── OR: Cohere (server-only) — free trial keys work (~1,000 calls/month, not for production use)
# With Cohere, voice input uses the browser's built-in speech recognition.
COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025
# If both keys are set, choose one:  AI_PROVIDER=openai | cohere   (default: openai)

# ── Accounts & sync (optional) ───────────────────────────────────
# Leave empty and everyone practices as a guest (progress saved in their browser).
# Supabase → Project Settings → API. The publishable key is designed to be public; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
