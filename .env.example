# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# NEVER commit .env.local. Never prefix secret keys with NEXT_PUBLIC_ (that exposes them to the browser).

# --- OpenAI (server-only) ---
# Leave empty to run in "demo mode" with scripted replies (no cost).
OPENAI_API_KEY=

# Optional model overrides
# OPENAI_CONVERSATION_MODEL=gpt-5.4-mini
# OPENAI_FEEDBACK_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# --- Supabase (not used yet — see lib/supabase.ts) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
